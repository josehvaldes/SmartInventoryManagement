      "post": {
        "tags": [
          "Sessions"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/revoke": {
      "post": {
        "tags": [
          "Sessions"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
