  "components": {
    "schemas": {
      "CreateProductRequest": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "unitOfMeasure": {
            "type": "string"
          },
          "minimumStockLevel": {
            "type": "number",
            "format": "double"
          },
          "reorderPoint": {
            "type": "number",
            "format": "double"
          },
          "reorderQuantity": {
            "type": "number",
            "format": "double"
          },
          "unitCost": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          }
        }
      },
      "CreateWarehouseRequest": {
        "type": "object",
        "properties": {
          "warehouseType": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "street": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "type": [
              "null",
              "string"
            ]
          },
          "postalCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          },
          "capacity": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "managerName": {
            "type": "string"
          },
          "managerEmail": {
            "type": "string"
          },
          "managerPhone": {
            "type": "string"
          },
          "createdBy": {
            "type": "string"
          }
        }
      },
      "GetUploadUrlRequest": {
        "type": "object",
        "properties": {
          "productSku": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "RemoveStockRequest": {
        "required": [
          "productId",
          "warehouseId",
          "quantity"
        ],
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "warehouseId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "SessionRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Versions"
    },
    {
      "name": "Products"
    },
    {
      "name": "Sessions"
    },
    {
      "name": "Stocks"
    },
    {
      "name": "Warehouses"
    }
  ]
