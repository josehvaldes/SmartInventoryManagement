{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AppSettings": {
    "AppName": "SmartInventory.Api",
    "AppVersion": "1.0.0",
    "ApiVersion": "v1"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "aspnetcore": {
    "MultipartBodyLengthLimit ": "10485760"
  },
  "ConnectionStrings": {
    "SmartInventoryDb": "",
    "redis": ""
  },
  "Cache": {
    "DefaultTTLSeconds": 300
  },
  "AwsSettings": {
    "Region": "us-east-2",
    "S3BucketName": "smart-inventory-bucket-name"
  },
  "JwtSettings": {
    "Secret": "defaultsecret",
    "Issuer": "defaultissuer",
    "Audience": "defaultaudience",
    "ExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "RefreshTokenRetentionDays": 30
  },
  "AllowedHosts": "*",
  "MemoryHealthCheck": {
    "DegradedThreshold": 805306368,
    "UnhealthyThreshold": 1073741824
  },
  "DiskHealthCheck": {
    "DriveName": "/",
    "DegradedThresholdPercentage": 20,
    "UnhealthyThresholdPercentage": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Information",
        "System": "Warning"
      }
    }
  }
}
