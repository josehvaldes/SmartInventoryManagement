# Copy this file to .env and fill in the values, then run:
#   docker run --rm -p 8080:8080 --env-file .env smartinventory-api:1.0
# Do not wrap values in quotes: --env-file keeps them literally.
# .env is git-ignored and listed in .dockerignore. Never commit it.
#
# Keys use the ASP.NET Core "__" separator and map to appsettings.json sections.
# Note: scripts/docker/.env is a separate file used by docker-compose-sqlserver.yml
# and only needs MSSQL_SA_PASSWORD.

# JWT (Secret must be at least 32 characters for HMAC-SHA256)
JwtSettings__Secret=your-production-secret-at-least-32-chars-long
JwtSettings__Issuer=SmartInventory
JwtSettings__Audience=SmartInventoryUsers
# Optional (defaults: 15 / 7 / 30)
# JwtSettings__ExpiryMinutes=15
# JwtSettings__RefreshTokenExpiryDays=7
# JwtSettings__RefreshTokenRetentionDays=30

# Database (read as ConnectionStrings:SmartInventoryDb)
ConnectionStrings__SmartInventoryDb=Server=host,1433;Database=SmartInventoryDB;User Id=sa;Password=...;TrustServerCertificate=True;

#MSSQL password for docker-compose-sqlserver.yml
MSSQL_SA_PASSWORD=...

# Redis / Garnet (read as ConnectionStrings:redis)
ConnectionStrings__redis=redis-host:6379
# Optional cache TTL in seconds (default 300)
# Cache__DefaultTTLSeconds=300

# AWS S3
AwsSettings__AccessKey=your-access-key
AwsSettings__SecretKey=your-secret-key
AwsSettings__Region=us-east-2
AwsSettings__S3BucketName=your-bucket-name

# CORS allowed origins (read as Cors:AllowedOrigins; add more with __1, __2, ...)
Cors__AllowedOrigins__0=http://localhost:3000

# MediatR license key. Optional with MediatR 12.5.0, which does not require one.
# MediatR__LicenseKey=
