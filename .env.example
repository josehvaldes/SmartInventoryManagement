# Copy this file to .env and fill in the values before running docker run
# .env is listed in .dockerignore and must never be committed

# JWT
JwtSettings__Secret=your-production-secret-at-least-32-chars-long
JwtSettings__Issuer=SmartInventory
JwtSettings__Audience=SmartInventoryUsers

# Database
ConnectionStrings__DefaultConnection=Server=host;Database=smart_inventory;User Id=sa;Password=...;TrustServerCertificate=True;

# Redis
Cache__ConnectionString=redis-host:6379
ConnectionStrings__RedisConnection=redis-host:6379

# AWS S3
AwsSettings__AccessKey=your-access-key
AwsSettings__SecretKey=your-secret-key
AwsSettings__Region=us-east-2
AwsSettings__S3BucketName=your-bucket-name

# MediatR
MediatR__LicenseKey=your-license-key
